[TEMPLATE]
# Copy this file to .env and fill in your keys.
# DEEPSEEK_API_KEY is required — it powers task generation and execution (OpenAI-compatible client).
DEEPSEEK_API_KEY=

# Composio API key for integrations (Gmail, Calendar, Slack, GitHub, Notion, etc.)
# Get it from https://composio.dev - this is REQUIRED for the app to function
COMPOSIO_API_KEY=

# A long random string used to sign the session cookie (any value; e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts secrets we store ourselves (currently: the Pronote login token) before they hit the database —
# defense-in-depth on top of Supabase RLS. Any value works (e.g. `openssl rand -hex 32`). The rest of the
# app runs fine without it (never blocks boot), but Pronote is the main feature for Otto Lycée — its
# connect flow REFUSES to run without this set, rather than ever store a school password's replacement
# token in plaintext.
CREDENTIAL_ENCRYPTION_KEY=

# FreeTTS API key for text-to-speech (https://freetts.org). Leave unset to use the browser's built-in
# speechSynthesis instead.
FREETTS_API_KEY=

# Where the app is reachable. Locally this is the Vite dev origin; in production it's your deployed HTTPS URL.
# Composio redirects back to `${PUBLIC_URL}/integrations/callback` after connecting an app, so PUBLIC_URL must
# match your real origin in production.
PUBLIC_URL=http://localhost:5273

# Port the backend listens on (dev: behind the Vite proxy; prod: serves the built app directly).
PORT=8788

# Which DeepSeek model to use for task generation + execution: deepseek-v4-flash (fast/cheap, default) or
# deepseek-v4-pro (heavier reasoning). The old names (deepseek-chat / deepseek-reasoner) are retired by
# DeepSeek and no longer accepted — the server maps them forward automatically if you still have one set.
DEEPSEEK_MODEL=deepseek-v4-flash

# Provider switch: set to "nvidia" to route every AI call through NVIDIA's OpenAI-compatible NIM endpoint
# instead of DeepSeek. Leave unset (or "deepseek") to keep using DeepSeek — the default, unchanged behavior.
# Switching back later is just changing this one value back; DEEPSEEK_API_KEY/DEEPSEEK_MODEL above are never
# touched by the switch either way, so keeping both providers' keys configured lets you flip freely.
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=
# NVIDIA_MODEL=mistralai/mistral-nemotron

# Monthly AI spend cap PER ACCOUNT, in USD (approximate, from DeepSeek per-token pricing). When an account
# crosses it, Otto pauses generation + execution for that account until the 1st. Default 3 if unset.
MONTHLY_AI_BUDGET_USD=3

# Protects GET /api/cron/drain (the background job runner Vercel Cron calls). Set the same value in the
# Vercel project env; requests without `Authorization: Bearer $CRON_SECRET` are rejected.
CRON_SECRET=

# Transactional email (Resend) — REQUIRED for password-reset emails to actually send. Without it,
# "forgot password" silently no-ops (the request still answers {ok:true} so account existence can't be
# probed — see /api/auth/forgot-password), and nobody can recover a locked-out account. Get a key from
# https://resend.com. The server warns at boot in production when this is missing.
RESEND_API_KEY=
# From address for those emails. Leave unset to use Resend's sandbox sender (onboarding@resend.dev —
# fine for testing, but real deliverability needs a verified domain, e.g. "Otto <no-reply@yourdomain.com>").
MAIL_FROM=

# Cloud persistence (optional, recommended). Profile + tasks are saved per account so they survive
# restarts and follow you. Run supabase.sql once in the Supabase SQL editor to create the tables.
# In PRODUCTION set SUPABASE_URL + SUPABASE_SERVICE_KEY — the service key bypasses RLS and MUST stay
# server-side (the app refuses to boot in production with only the anon key). The VITE_* anon-key vars
# below are a local-dev fallback only.
SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Error tracking (optional). Without these, failures (a Supabase write that fails, a sweep that dies for
# one account, a client render crash) only ever reach console.error/warn — invisible in practice on Vercel.
# SENTRY_DSN is server-side (server/sentry.ts). VITE_SENTRY_DSN is client-side (client/main.tsx) — a DSN
# isn't a secret (it's meant to be embedded in client code), so the VITE_ prefix exposing it to the browser
# bundle is intentional, not a leak. Get both from a free Sentry project at https://sentry.io.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Blackbaud (school Education Management — assignments/grades). Real OAuth authorization-code flow is
# implemented (server/blackbaud.ts) — but it needs ALL THREE of the values below to actually work, not just
# the subscription key. The subscription key alone (BLACKBAUD_SUBSCRIPTION_KEY) identifies which app is
# calling the API; it does NOT authorize access to any student's data — that needs a separate OAuth
# "Application" registered in the Blackbaud developer portal (developer.blackbaud.com), which gives you
# BLACKBAUD_CLIENT_ID + BLACKBAUD_CLIENT_SECRET. Without those two, blackbaudConfigured() stays false and
# only mock mode (BLACKBAUD_MOCK) works, regardless of the subscription key being set.
BLACKBAUD_SUBSCRIPTION_KEY=
BLACKBAUD_CLIENT_ID=
BLACKBAUD_CLIENT_SECRET=
# Must exactly match a redirect URI whitelisted on the OAuth Application in the Blackbaud developer portal —
# defaults to `${PUBLIC_URL}/api/integrations/blackbaud/callback` if unset (see server/blackbaud.ts).
BLACKBAUD_REDIRECT_URI=
# Fully offline mock — no real credentials needed at all, canned fake assignments. Set to 1 to enable
# Settings' "Try demo mode" button. Independent of the three vars above; works with none of them set.
BLACKBAUD_MOCK=
